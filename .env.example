########################################
# KACECommerceEngine — local dev env
########################################
# Copy to .env for local development.
# All variables are zod-validated at boot; missing/invalid values → fast fail.

# --- Server ---
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug                       # trace | debug | info | warn | error | fatal

# --- Postgres (SoT for sessions, rewards, metaobject cache) ---
DATABASE_URL=postgres://kace:kace@localhost:5432/kace_dev
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10

# --- Redis (warm cache for sessions) ---
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL_S=3600              # 1 hour

# --- MongoDB (optional trace/metadata log; can be disabled in v0) ---
MONGODB_URL=mongodb://localhost:27017/kace_trace
MONGODB_ENABLED=false

# --- In-process LRU session cache ---
LRU_TTL_MS=300000                     # 5 minutes
LRU_MAX=1000                          # entries

# --- Session AES-GCM encryption ---
ENCRYPTION_KEY_ID=v1
ENCRYPTION_KEY_V1=replace_me_base64_256_bit_key_here
# ENCRYPTION_KEY_V2=...

# --- Shopify OAuth install (KACE-PromptKart app in Dev Dashboard) ---
SHOPIFY_API_KEY=replace_with_client_id_from_dev_dashboard
SHOPIFY_API_SECRET=replace_with_client_secret_from_dev_dashboard
SHOPIFY_APP_URL=https://<your-cloudflared-subdomain>.trycloudflare.com
SHOPIFY_SCOPES=read_products,write_products,read_customers,read_orders,read_metaobjects,write_metaobjects,read_inventory
SHOPIFY_API_VERSION=2026-01
SHOPIFY_DEFAULT_TENANT=PROMPTKART

# --- Multi-engine rule facade (not wired up yet in Phase P3 — scaffolded for later) ---
# RULE_ENGINES=json-rules,nools,rete-next,ext-rules-sidecar/drools
# RANKER_MODE=consensus
# ENGINE_TIMEOUT_MS=500
# EXT_RULES_SIDECAR_URL=http://localhost:8081

# --- Secrets mode (SecretsProvider facade — Phase P3) ---
# SECRETS_MODE=primary-mirror
# AWS_REGION=us-east-1
# AWS_SECRETS_PREFIX=kace/
# AZURE_KEY_VAULT_URL=https://kace-dev-kv.vault.azure.net/
